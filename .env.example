# ── CriptoMundo v4 ──────────────────────────────────────────
# Copia a .env y ajusta. El servidor lee variables de entorno,
# no lee el archivo .env por sí solo: úsalo con tu gestor de
# procesos, con docker --env-file o exportando a mano.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Dónde se guarda el estado. Ponlo FUERA de la carpeta del código.
DATA_FILE=/var/lib/criptomundo/criptomundo-data.json
ASSETS_DIR=/opt/criptomundo/assets

# Panel de analítica (/admin.html). Sin esto, el panel queda cerrado.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Orígenes permitidos para CORS, separados por comas.
# Vacío = solo mismo origen, que es lo correcto si sirves el juego y la API juntos.
ALLOWED_ORIGINS=

# Límites de ritmo. Súbelos si tus jugadores comparten red.
REGISTER_LIMIT_PER_HOUR=20
REQUEST_LIMIT_PER_MINUTE=300

# ── Web3 (todavía NO activo) ────────────────────────────────
# CGRID es un saldo interno del juego. No hay contrato desplegado.
# CHAIN_ID=80002
# RPC_URL=
# CGRID_CONTRACT=
